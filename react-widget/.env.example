# Environment Variables for Vite React App

# Development
VITE_CHATBOT_API_URL=http://127.0.0.1:5000/chat

# Production (update with your deployed backend URL)
# VITE_CHATBOT_API_URL=https://your-backend-api.herokuapp.com/chat
# VITE_CHATBOT_API_URL=https://your-backend-api.railway.app/chat
# VITE_CHATBOT_API_URL=https://your-backend-api.onrender.com/chat

# Note: Vite requires environment variables to be prefixed with VITE_
# Access in code: import.meta.env.VITE_CHATBOT_API_URL
